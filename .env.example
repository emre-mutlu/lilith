GEMINI_API_KEY=
# Metin modeli (opsiyonel). Boş bırakılırsa varsayılan: gemini-3.5-flash-lite (pin — alias kullanma)
# Not: gemini-2.5-flash çok yavaş ölçüldü (5145ms); gemini-3.7-flash yeni çıktığından 503 veriyor (Ağu 2026)
GEMINI_MODEL=
# Geçmiş penceresi (mesaj adedi, varsayılan 20). Faz 2'de 12/20/30 A/B ölçümü planlı
GEMINI_HISTORY=
# Azure Speech (F0 bedava: 500K karakter/ay) — ⚠ PARK HALİNDE (08-24): kullanılmıyor.
# Key'i boş bırak; ayarlı olsa da merdiven local→edge zaten yeterli. Kod referans için duruyor.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Ses override (opsiyonel): multilingual adaylar Ava/Andrew/Seraphina/Adam/Emma...
# AZURE_VOICE_LILITH=en-US-AvaMultilingualNeural
# AZURE_VOICE_GENERIC=en-US-AndrewMultilingualNeural
# Fish Audio (bulut TTS, s2.1-pro-free) — API KEY repoya YAZILMAZ: Operator kasasında
# (`operator secret set lilith FISH_AUDIO_KEY` → `operator secret run lilith -- npm run dev`)
FISH_MODEL_LILITH=
FISH_MODEL_GENERIC=
# low | balanced | normal (normal = en kararlı; balanced = interaktif, ~%40 hızlı)
FISH_LATENCY=normal
# Chatterbox yerel TTS (M4 Pro'da sınırsız) — CHATTERBOX_PYTHON ayarsızsa katman atlanır
# Değer: chatterbox kurulmuş venv'in python'ı (örn. /path/venv/bin/python)
CHATTERBOX_PYTHON=
LOCAL_TTS_EXAGGERATION=1.2
LOCAL_TTS_DRAMATIZE=1
LOCAL_TTS_SPEAKERS=lilith,generic
PORT=
